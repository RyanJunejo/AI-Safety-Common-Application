# Copy to .env.local for local development. Set the same names in Vercel (Production and Preview).
# Without the two VITE_SUPABASE_* values, the site runs as a preview with the bundled catalog snapshot.

# ---- Browser (public; built into the site) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase > Settings > API Keys. A publishable key (sb_publishable_...) is preferred; a legacy anon key also works.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Server only (Vercel Functions). Never prefix these with VITE_. ----
# Supabase > Connect > Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Secret key (sb_secret_...), used only to delete accounts. A legacy service_role key also works as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# Random strings of 32+ characters, e.g. `openssl rand -hex 32`.
CRON_SECRET=
UNSUBSCRIBE_SECRET=
# Resend > API Keys, with sending access for the verified safetyapps.org domain.
RESEND_API_KEY=
ALERTS_FROM="SafetyApps <alerts@safetyapps.org>"
ALERTS_REPLY_TO=hello@safetyapps.org
# Where sync and delivery failures are reported.
OPS_EMAIL=
SITE_URL=https://safetyapps.org
# Optional. Overrides the AISafety.com API base URL, e.g. to rehearse a failed sync on staging.
AISAFETY_API_URL=
